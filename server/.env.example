# Server port (automatically provided by Render via process.env.PORT)
PORT=3001

# Allowed frontend origin(s) for CORS (comma-separated, or * for wildcard)
# In production on Render, set this to your deployed Vercel frontend URL:
# Example: CLIENT_ORIGIN=https://anything-but-a-motion-controller.vercel.app
CLIENT_ORIGIN=https://anything-but-a-motion-controller.vercel.app
