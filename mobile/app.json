{
  "expo": {
    "name": "Anything but a Game Controller",
    "slug": "anything-but-a-game-controller",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "abgc",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anythingbutagamecontroller.mobile",
      "infoPlist": {
        "NSMotionUsageDescription": "Motion sensors are used to tilt-steer the maze ball in Anything but a Game Controller."
      }
    },
    "android": {
      "package": "com.anythingbutagamecontroller.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "serverUrl": "https://anythingbutamotioncontroller.onrender.com",
      "router": {},
      "eas": {
        "projectId": "85693a41-76bf-4a1d-9485-112774335dd1"
      }
    },
    "owner": "ash295"
  }
}
