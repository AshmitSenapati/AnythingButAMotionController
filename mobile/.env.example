# Socket.IO server URL for the mobile controller app.
# When testing against the deployed Vercel game, set this to the deployed Render backend:
EXPO_PUBLIC_SERVER_URL=https://anythingbutamotioncontroller.onrender.com

# For local development (laptop and phone on same local Wi-Fi), use your laptop's LAN IP:
# EXPO_PUBLIC_SERVER_URL=http://192.168.1.100:3001
